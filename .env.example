# Postgres (compose `db` usa estas tres)
DB_NAME=barriles_db
DB_USER=barriles_user
DB_PASSWORD=change_me
DB_PUBLISH_PORT=5433

# Conexión **solo cuando corrés el backend con `npm run dev` en tu PC**.
# Si usás Docker (`docker-compose.dev.yml`), ese compose fuerza DB_HOST=db / DB_PORT=5432 dentro del backend.
DB_HOST=127.0.0.1
DB_PORT=5432

# Producción / cloud (Neon, Supabase, Railway Postgres):
# Usar DATABASE_URL en lugar de DB_HOST/DB_PORT/etc. Si está definida, manda.
# DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require
# Algunos proveedores (Neon, Supabase) no traen un CA público en cadena;
# si ves "self-signed certificate in certificate chain", desactivar la
# verificación de cert con:
# DB_SSL_REJECT_UNAUTHORIZED=false

NODE_ENV=development
PORT=4000
BACKEND_PUBLISH_PORT=4000
FRONTEND_PUBLISH_PORT=5173

JWT_SECRET=change_me_jwt_secret

ADMIN_EMAIL=admin@3barriles.local
ADMIN_PASSWORD=change_me_admin_password
AUTO_SEED_ADMIN=true

CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173

VITE_API_URL=http://localhost:4000

# Frontend: si es false, cierra sesión y muestra aviso en login (sin acceso al panel).
BACK_ON=true
